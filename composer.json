{
  "name": "dpdconnect/php-sdk",
  "type": "library",
  "description": "DPD Connect PHP SDK",
  "license": "OSL-3.0",
  "authors": [
    {
      "name": "DPD",
      "email": "pluginsupport@dpd.nl",
      "homepage": "http://www.dpd.nl"
    }
  ],
  "support": {
    "email": "pluginsupport@dpd.nl",
    "issues": "http://www.dpd.nl"
  },
  "autoload": {
    "psr-4": {
      "DpdConnect\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DpdConnect\\Sdk\\Test\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "symfony/yaml": "^6.4 || ^7.0",
    "donatj/mock-webserver": "^2.7",
    "overtrue/phplint": "~9.6.0",
    "squizlabs/php_codesniffer": "^3.13.6",
    "phpunit/phpunit": "^10.5"
  },
  "config": {
    "bin-dir": "bin"
  }
}
